      "roles": [
        {
          "description": "Gunakan sprite isometrik pixel-art 2D yang jelas untuk karakter utama Anda serta penghuni manusia dan AI, dengan variasi yang cukup untuk membedakan peran tanpa menambah kerumunan dekoratif.",
          "id": "karakter-pemain-penghuni",
          "label": "Karakter pemain dan penghuni kota"
        },
        {
          "description": "Tampilkan bangunan isometrik yang mudah dikenali untuk Town Square, Residential, Commercial, Industrial, Civic, dan Park District agar Anda dapat memilih tujuan dan memahami fungsi lokasi dengan cepat.",
          "id": "bangunan-destinasi-distrik",
          "label": "Bangunan dan destinasi enam distrik"
        },
        {
          "description": "Gunakan visual sederhana untuk jalan, trotoar, lahan, dan batas area agar pergerakan serta hubungan antardistrik Anda terbaca, tanpa memperluas dekorasi kota yang tidak dibutuhkan MVP.",
          "id": "jalur-dan-permukaan-kota",
          "label": "Jalur dan permukaan kota yang terbaca"
        },
        {
          "description": "Bedakan titik kerja, toko, serta usaha yang dapat Anda kelola melalui fasad atau objek interaksi yang jelas sehingga alur kerja → upah → belanja → produksi mudah dipahami.",
          "id": "lokasi-kerja-belanja-bisnis",
          "label": "Lokasi interaktif untuk kerja, belanja, dan bisnis"
        },
        {
          "description": "Pertahankan antarmuka yang jelas untuk wallet, ledger, inventaris, reputasi, relasi, direktori, profil, activity feed, event, audit, notifikasi, dan tombol aksi Anda, dengan tata letak desktop/mobile serta reduced motion.",
          "id": "hud-panel-simulasi",
          "label": "HUD dan panel simulasi responsif"
        },
        {
          "description": "Gunakan penanda visual sederhana untuk tujuan terpilih, karakter yang dapat diajak berinteraksi, pekerjaan tersedia, transaksi, kebutuhan, relasi, memori episodik, event, dan catch-up offline Anda tanpa bergantung pada animasi berlebih.",
          "id": "penanda-status-dan-interaksi",
          "label": "Penanda status dan interaksi"
        }
      ]
    },
